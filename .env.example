# Postgres connection string. Neon sets this automatically on Vercel; locally point at your own Postgres.
DATABASE_URL=postgres://localhost:5432/studioikigai_research
# Password for /research/admin. Compared in constant time; rotate by changing it and redeploying.
RESEARCH_ADMIN_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs the admin session cookie and salts the rate limiter. Rotating it logs everyone out.
RESEARCH_SESSION_SECRET=
